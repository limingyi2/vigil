{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigil.invalid/schemas/extension-manifest.schema.json",
  "title": "Vigil Extension Manifest",
  "description": "Strict install-time metadata contract. Validation does not attest that extension code is trustworthy.",
  "oneOf": [
    { "$ref": "#/$defs/desktopExtension" },
    { "$ref": "#/$defs/channelBridge" }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": ["schema", "id", "version", "kind", "entry", "min_core", "protocol", "artifacts", "permissions", "files", "data_migrations"],
      "properties": {
        "schema": { "const": "vigil.extension/v1" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 80 },
        "version": { "$ref": "#/$defs/semver" },
        "kind": { "enum": ["desktop-extension", "channel-bridge"] },
        "entry": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]{1,180}$" },
        "min_core": { "$ref": "#/$defs/semver" },
        "protocol": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "major", "min_minor"],
          "properties": {
            "name": { "enum": ["vigil-desktop-extension", "vigil-channel-bridge"] },
            "major": { "type": "integer", "minimum": 1 },
            "min_minor": { "type": "integer", "minimum": 0 }
          }
        },
        "artifacts": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["platform", "url", "sha256"],
            "properties": {
              "platform": { "enum": ["windows-x64", "windows-arm64", "linux-x64", "linux-arm64", "macos-arm64", "macos-x64", "any"] },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "permissions": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["desktop.wallpaper.control", "desktop.ui.contribute", "channel.events.read", "channel.messages.send", "brain.chat.invoke"] }
        },
        "files": {
          "type": "array", "minItems": 1, "maxItems": 10000,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]{1,240}$" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "renderer": {
          "type": "object", "additionalProperties": false,
          "required": ["script", "style"],
          "properties": {
            "script": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]{1,180}$" },
            "style": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]{1,180}$" }
          }
        },
        "data_migrations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "from", "to", "strategy"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
              "from": { "type": "string", "maxLength": 80 },
              "to": { "type": "string", "maxLength": 80 },
              "strategy": { "enum": ["copy-verify-commit"] }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "desktopExtension": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "type": "object", "properties": { "kind": { "const": "desktop-extension" }, "protocol": { "type": "object", "properties": { "name": { "const": "vigil-desktop-extension" } } }, "permissions": { "type": "array", "items": { "enum": ["desktop.wallpaper.control", "desktop.ui.contribute"] } } } },
        { "type": "object", "properties": { "renderer": true }, "required": ["renderer"] }
      ]
    },
    "channelBridge": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "type": "object", "properties": { "kind": { "const": "channel-bridge" }, "protocol": { "type": "object", "properties": { "name": { "const": "vigil-channel-bridge" } } }, "permissions": { "type": "array", "items": { "enum": ["channel.events.read", "channel.messages.send", "brain.chat.invoke"] } } } },
        { "not": { "type": "object", "properties": { "renderer": true }, "required": ["renderer"] } }
      ]
    }
  }
}
