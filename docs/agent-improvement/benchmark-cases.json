{
  "schema_version": 1,
  "description": "Vigil Agent preflight benchmark. Commands are argv arrays, never shell strings. Run from repository root.",
  "suites": {
    "smoke": [
      "agent-run-lifecycle",
      "plan-observability",
      "runtime-trace"
    ],
    "regression": [
      "agent-run-lifecycle",
      "plan-observability",
      "runtime-trace",
      "local-tool-boundaries",
      "provider-contract",
      "conversation-isolation",
      "run-mode-http",
      "codex-reasoning-events"
    ]
  },
  "tests": [
    {
      "id": "agent-run-lifecycle",
      "title": "Agent run lifecycle and HTTP contract",
      "area": "execution/state",
      "argv": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/test_p2_agent_runs.py"
      ],
      "timeout_seconds": 300
    },
    {
