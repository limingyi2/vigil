  "behavior_scenarios": [
    {
      "id": "real-agent-execution",
      "area": "agent/execution",
      "environment_type": "real-model",
      "goal": "Complete a bounded task through the production Agent execution path using a controlled real-model account.",
      "acceptance": [
        "Task reaches explicit terminal state",
        "Result satisfies a written task-specific acceptance rubric",
        "No unrequested source or user-data changes"
      ],
      "status": "NOT RUN"
    },
    {
      "id": "tool-call-correctness",
      "area": "tools/calls",
      "environment_type": "real-model-or-fake-provider",
      "goal": "Exercise tool selection, argument validation, denial, and retry behavior.",
      "acceptance": [
        "Calls match available tool schemas",
        "Denied actions have no side effect",
        "Retries do not repeat non-idempotent calls"
      ],
      "status": "NOT RUN"
    },
    {
      "id": "large-tool-result",
      "area": "tools/context",
      "environment_type": "automated-plus-manual",
      "goal": "Return a tool result larger than current output limits and inspect chunk retrieval and user-visible truncation.",
      "acceptance": [
        "Progress is retained",
        "Truncation is explicit",
        "Memory remains bounded"
      ],
      "status": "NOT RUN"
    },
    {
      "id": "stream-disconnect",
      "area": "stream/events",
      "environment_type": "electron-or-e2e",
      "goal": "Disconnect and reconnect the UI while an Agent run is active.",
      "acceptance": [
        "Run identity remains stable",
        "Snapshot exposes actual state",
        "No duplicate side-effecting call"
      ],
      "status": "PASS",
      "evidence": {
        "date": "2026-10-20",
        "command": "node client/tools/test-electron-brain-e2e.js (VIGIL_E2E_SCENARIO=agent-chat-reconnect)",
        "report": "%LOCALAPPDATA%/Vigil/stage2-state/phase2-ag002-chat-reconnect-focused-final.log",
        "scope": "Real Electron renderer and main process, local Brain, loopback Fake Provider, one injected SSE disconnect; does not cover a real Provider or prolonged pressure."
      }
    },
    {
      "id": "task-state-and-cancel",
      "area": "execution/state",
      "environment_type": "electron-or-e2e",
      "goal": "Observe queued, running, terminal, and cancelled states across UI/Brain; cancel model generation and a long tool.",
      "acceptance": [
        "UI and Brain states agree",
        "Cancellation has explicit terminal state",
        "No next step after cancellation"
      ],
      "status": "NOT RUN"
    },
    {
      "id": "context-budget",
      "area": "context",
      "environment_type": "real-model-or-e2e",
      "goal": "Run a long context task with history and large tool results.",
      "acceptance": [
        "Budget behavior is observable",
        "Relevant evidence is preserved",
        "No silent context loss"
      ],
      "status": "NOT RUN"
    },
    {
      "id": "session-recovery",
      "area": "session/recovery",
      "environment_type": "electron-or-e2e",
      "goal": "Restart/reconnect the application and resume a persisted session.",
      "acceptance": [
        "Session identity and persisted state are accurate",
        "Transient events are not claimed as persisted"
      ],
      "status": "NOT RUN"
    },
    {
      "id": "plugin-lifecycle",
      "area": "plugins",
      "environment_type": "external-fixture",
      "goal": "Install, authorize, invoke, and remove a disposable test plugin.",
      "acceptance": [
        "Manifest validation is enforced",
        "Permission boundaries hold",
        "No unrelated plugin/user data changed"
      ],
      "status": "NOT RUN"
    },
    {
      "id": "provider-timeout",
      "area": "provider/errors",
      "environment_type": "fake-provider",
      "goal": "Inject connect timeout, stream disconnect, empty response and malformed event.",
      "acceptance": [
        "Failure category is specific",
        "Run cannot remain indefinitely active",
        "Retry policy respects idempotency"
      ],
      "status": "NOT RUN"
    },
    {
      "id": "permission-boundary",
      "area": "security",
      "environment_type": "automated-plus-manual",
      "goal": "Attempt unauthorized tool use and path traversal in a disposable workspace.",
      "acceptance": [
        "Operation is denied",
        "No out-of-scope file changed",
        "Denial is visible in trace"
      ],
      "status": "NOT RUN"
    }
  ],
