{
  "source_worker": "<REPO>/vigil-eval/adapters/ollama_worker.py",
  "tools": [
    {
      "name": "file_list",
      "description": "列出指定目录下的文件和子目录（仅文件名+类型），用于先勘察 workspace 结构。当你需要知道某个目录里有什么文件时，先用这个；不要用 read_file 去猜目录。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "workspace 内相对路径，默认 '.'"
          }
        },
        "required": []
      }
    },
    {
      "name": "file_find",
      "description": "在 workspace 内按文件名通配符（如 *.py、test_*.txt）查找匹配文件，返回匹配文件的相对路径列表。当你知道文件名片段但不知道完整路径时用这个。",
      "parameters": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "description": "glob 通配符，如 *.py（必填）"
          },
          "path": {
            "type": "string",
            "description": "搜索根目录，默认 '.'"
          }
        },
        "required": [
          "pattern"
        ]
      }
    },
    {
      "name": "read_file",
      "description": "读取 workspace 内某个文本文件的完整内容（UTF-8）。当你已经知道要读哪个具体文件时用这个；不要用来列目录。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "文件相对路径（必填）"
          }
        },
        "required": [
          "path"
        ]
      }
    },
    {
      "name": "replace_text",
      "description": "在指定文件中把 old 文本替换为 new 文本（最小修改，不整文件覆写）。A03 类小改用这个；不要用它创建新文件。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "文件相对路径（必填）"
          },
          "old": {
            "type": "string",
            "description": "要查找的原文（必填）"
          },
          "new": {
            "type": "string",
            "description": "替换后的新文本（必填）"
          }
        },
        "required": [
          "path",
          "old",
          "new"
        ]
      }
    },
    {
      "name": "pytest",
      "description": "在 workspace 根目录下运行 pytest 跑指定测试文件，返回 exit code 和尾部输出。改完代码后用这个验证。",
      "parameters": {
        "type": "object",
        "properties": {
          "test_file": {
            "type": "string",
            "description": "测试文件相对路径（必填）"
          },
          "path": {
            "type": "string",
            "description": "备选：测试文件相对路径"
          }
        },
        "required": [
          "test_file"
        ]
      }
    }
  ],
  "intentionally_not_exposed": [
    "write_file",
    "mock_http",
    "mock_timeout",
    "mock_permission",
    "shell / bash / exec (unimplemented and not in allowlist)"
  ]
}
